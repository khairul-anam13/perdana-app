# Salin ke .env lalu isi.

# Lokal (PostgreSQL sendiri):
DATABASE_URL="postgresql://perdana:perdana_dev_local@localhost:5432/perdana"

# Supabase. Dua alamat, port beda, password sama:
#   5432 = session pooler: untuk laptop Anda (migrasi `pnpm db:deploy`, `pnpm db:admin`, tes).
#   6543 = transaction pooler: untuk Vercel (serverless), isi di Environment Variables Vercel.
# DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# Minimal 32 karakter acak. Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Pakai nilai BERBEDA untuk lokal dan produksi.
AUTH_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter"
